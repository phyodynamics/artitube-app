# ===========================================
# Arti Tube - Environment Variables
# ===========================================
# ဒီဖိုင်ကို ".env.local" အမည်ဖြင့် copy ကူးပြီး
# မိမိ Supabase Dashboard မှ ရရှိသော key များကို ဖြည့်ပေးပါ။
#
# cp .env.example .env.local
# ===========================================

# Supabase Project URL (Dashboard > Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon/Public Key (Dashboard > Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Dashboard > Settings > API > service_role secret)
# ⚠️ ဒီ key ကို frontend code ထဲမှာ လုံးဝ မထည့်ပါနဲ့။ Server Actions များအတွက်သာ သုံးပါ။
SUPABASE_SERVICE_ROLE_KEY=
